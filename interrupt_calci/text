static irqreturn_t keyboard_irq_handle(int irq, void *dev_id){
	unsigned char scancode;
	scancode = inb(KBD_DATA_PORT);
	int a,b;
	if(cout > BUFF_SIZE -1){
		cout = BUFF_SIZE - 1;
	}
	if(copy_from_user(buffer, user_buf, count)){
		return -EFAULT;
	}
	buffer[count] = '\0';
	
	switch (scancode) {
		case '0x0D':
			result_size = snprintf(result, BUF_SIZE, "%d\n", a + b); 
			break;
		case '0x0C':
        		result_size = snprintf(result, BUF_SIZE, "%d\n", a - b); 
        		break;

    		case '0x37':
        		result_size = snprintf(result, BUF_SIZE, "%d\n", a * b); 
        		break;

    		case '0x35':
        		if (b == 0)
            			result_size = snprintf(result, BUF_SIZE, "Error: divide by zero\n");
        		else
            			result_size = snprintf(result, BUF_SIZE, "%d\n", a / b); 
        			break;

    		default:
        		result_size = snprintf(result, BUF_SIZE, "Error: unknown operator\n");
        		break;
	}   
	return count;
}

static ssize_t my_read(struct file *file, char __user *user_buf, size_t count, loff_t *ppos){
	if(*ppos > 0){
		return 0;
	}
	if(copy_to_user(user_buf, result, result_size)){
		return -EFAULT;
	}
	*ppos = result_size;
	return result_size;
}


static int __init keyboard_init(void){
	int result;
	printk(KERNEL_INFO "loading calci\n" );
	result = request_irq(KEYBOARD_IRQ, keyboard_irq_handler, IRQF_SHARED, "keyboard_irq_handler", (void*)keyboard_irq_handler);

	if(result){
		printk(KERN_ERR "cannot register IRQ %d\n", KEYBOARD_IRQ);
		return result;
	}
	printk(KERN_INFO "handle removed\n");
	return 0;
}

static void __exit keyboard_exit(void){
	free_irq(KEYBOARD_IRQ, (void*)keyboard_irq_handler);
	printk(KERN_INFO "handler removed\n");
}

module_init(keyboard_init);
module_exit(keyboard_exit);

