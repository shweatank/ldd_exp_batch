#include<linux/module.h>
#include<linux/kernel.h>
#include<linux/init.h>
#include<linux/interrupt.h>
#include<asm/io.h>

#define KEYBOARD_IRQ 1
#define KBD_DATA_PORT 0x60

irqreturn_t keyboard_irq_handle(int irq, void *dev_id){
	unsigned char scancode;

	scancode = inb(KBD_DATA_PORT);
	printk(KERN_INFO "keboard ipr: scancode = 0x%2x\n",scancode);
	return IRQ_HANDLE;
}

static int __int keyboard_irq_init(void){
	int result;

	printk(KERNE_INFO "loading custom keyboard irq handle\n");
	// request irq 1 (keyboard interrupt)
	result = request_irq(KEYBOARD_IRQ, keyboard_irq_handler, IRQF_SHARED, "keyboard_irq_handler", (void *)(keyboard_irq_handler));

	if(result){
		printk(KERN_ERR "keyboard_irq_: cannot resister irq %d\n", KEYBOARD_IRQ);
		return result;
	}

	printk(KERN_INFO "kebpoard_irq: irq handle registered successfully ");
	return 0;
}
static void __exit keyboard_irq_exit(void){
	free_irq(KEYBOARD_IRQ, (void* )(keyboard_irq_handler));
	printk(KERN_INFO "keyboard_irq: irq handler removed\n");
}

module_init(init_fun);
module_exit(exit_fun);
MODULE_LICENSE("GPL");
MODULE_DESCRIPTION("keyboard handler for x89 linux");

